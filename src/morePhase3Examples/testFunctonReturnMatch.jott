#this will fail phase 3.
# Tests function return matches
# addToLiust returns an integer and not a List
# List and Printer are built in classes

Module TestLists Subclass Object
	Shared addToList -> count:Integer <- List
		List myList
		myList = Create List[]
		While[count >= 0]
			::myList.add[count]
			count = count - 1 
		<- count

	Open printHello
		List myList
		myList = ::addToList[5]
		While[::myList.count[] > 0]
			::Printer.display[::myList.first[]]
			::Printer.display[::myList.last[]]
			::myList.pop[]
