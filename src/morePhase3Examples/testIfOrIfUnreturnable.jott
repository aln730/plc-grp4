#this will fail phase 3
# There is no return path after the if not being returnable
# We do not test to see if the If and OrIf have to run because of their conditions
# List and Printer are built in classes

Module TestLists Subclass Object
	Shared addToList -> count:Integer, start:Double <- List
		List myList
		myList = Create List[]
		If[count <= 0]
			<- myList
		OrIf[count > 0]
			While[count >= 0]
				::myList.add[start]
				count = count - 1
				start = start + 1.1
			<- myList

	Open printHello
		List myList
		myList = ::addToList[5, 0.0]
		While[::myList.count[] > 0]
			::Printer.display[::myList.first[]]
			::Printer.display[::myList.last[]]
			::myList.pop[]
