#this will fail phase 3.
# Tests while is a boolean condition
# While in printHello has a integer conditional
# List and Printer are built in classes

Module TestLists Subclass Object
	Shared addToList -> count:Integer <- List
		List myList
		myList = Create List[]
		While[count >= 0]
			::myList.add[count]
		<- myList

	Open printHello
		List myList
		myList = ::addToList[5]
		While[::myList.count[] + 0]
			::Printer.display[::myList.first[]]
			::Printer.display[::myList.last[]]
			::myList.pop[]
